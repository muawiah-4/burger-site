# Shared secret for the demo kitchen control (PATCH /api/orders/:id/status, header X-Admin-Token).
# Leave empty to disable the endpoint. Must be at least 16 characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# Optional: SQLite file location (default ./data/ember.db).
# EMBER_DB_PATH=./data/ember.db

# Optional: set to "off" to stop the simulated kitchen from advancing order status over time.
# KITCHEN_SIMULATION=on

# Optional: extra origins (comma-separated, e.g. https://ember.example) allowed by the CSRF Origin
# check on account routes, for setups where the browser-facing host differs from the Host header.
# TRUSTED_ORIGINS=

# Optional, local testing only: set to "1" to drop the Secure flag from the session cookie when running a
# production build over plain http://localhost. Safari needs it there: unlike Chrome, it won't store a
# Secure cookie on http://localhost, so you'd be signed out on every request. Never set this in a real
# deployment. (The Playwright test server sets it.)
# INSECURE_COOKIES=1
