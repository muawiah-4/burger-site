# Shared secret for the demo kitchen control (PATCH /api/orders/:id/status, header X-Admin-Token).
# Leave empty to disable the endpoint. Must be at least 16 characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# Optional: SQLite file location (default ./data/ember.db).
# EMBER_DB_PATH=./data/ember.db

# Optional: set to "off" to stop the simulated kitchen from advancing order status over time.
# KITCHEN_SIMULATION=on
